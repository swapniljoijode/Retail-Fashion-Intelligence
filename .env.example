# ── Fashion Retail Intelligence Platform — environment variables ──────────────
# Copy this file to .env, fill in real values, and NEVER commit .env to git.
# All pipeline credentials live in GitLab CI/CD variables, not here.

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID visible in the Cloudflare dashboard URL
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 API token — create in Cloudflare dashboard > R2 > Manage API Tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Bucket names (create these before running ingestion)
R2_RAW_BUCKET=fashion-retail-raw
R2_SERVED_BUCKET=fashion-retail-served

# ── Snowflake ─────────────────────────────────────────────────────────────────
# Account identifier format: orgname-accountname (e.g. myorg-myaccount)
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_DATABASE=FASHION_RETAIL
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_SCHEMA=RAW

# Key-pair authentication (recommended over password)
# Generate with: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out snowflake_key.p8 -nocrypt
SNOWFLAKE_PRIVATE_KEY_PATH=./snowflake_key.p8

# ── DuckDB ────────────────────────────────────────────────────────────────────
# Path to the local DuckDB file; used for the shadow warehouse and CI
DUCKDB_PATH=./dbt/fashion_retail.duckdb

# ── Data generation ───────────────────────────────────────────────────────────
# Fixed seed keeps all runs reproducible
GENERATION_SEED=42
# small | large
GENERATION_VOLUME=small

# ── Project Tracker ───────────────────────────────────────────────────────────
# Base URL for the deployed Project Tracker API
TRACKER_API_URL=https://your-tracker.vercel.app/api
TRACKER_API_KEY=your_tracker_api_key
