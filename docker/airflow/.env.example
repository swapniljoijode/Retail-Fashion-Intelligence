# Copy to docker/airflow/.env and fill in your values.
# This file is safe to commit — it contains no secrets.

# Airflow metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow security — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Airflow admin UI login
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Cloudflare R2 — optional; upload_r2 task is skipped when not set
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RAW_BUCKET=fashion-retail-raw
R2_SERVED_BUCKET=fashion-retail-served
